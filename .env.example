# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/meetbrief

# ─── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── SMTP / Nodemailer ────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM_NAME=MeetBrief
SMTP_FROM_EMAIL=no-reply@meetbrief.com

# ─── Admin Auth ────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-32-char-string
ADMIN_EMAIL=admin@meetbrief.com
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12,(_,h)=>console.log(h))"
ADMIN_PASSWORD_HASH=$2b$12$replacethiswithrealhash
